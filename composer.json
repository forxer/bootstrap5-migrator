{
    "name": "forxer/bootstrap5-migrator",
    "description": "Migrate Laravel applications from Bootstrap 4.6 to Bootstrap 5.x",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "migrator",
        "bootstrap"
    ],
    "authors": [
        {
            "name": "Vincent Garnier"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "symfony/process": "^6.0 || ^7.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0.5",
        "laravel/pint": "^1.22.1",
        "phpunit/phpunit": "^10.5.47",
        "orchestra/testbench": "^8.36",
        "rector/rector": "^2.1.0"
    },
    "autoload": {
        "psr-4": {
            "Bootstrap5Migrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bootstrap5Migrator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bootstrap5Migrator\\ServiceProvider"
            ]
        }
    }
}
